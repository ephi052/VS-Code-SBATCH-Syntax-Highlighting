{
  "name": "sbatch",
  "icon": "icon.png",
  "displayName": "SBATCH File Syntax Highlighter and SLURM Job Submission",
  "description": "Syntax highlighting and job submission for .sbatch files in SLURM.",
  "version": "0.0.3",
  "publisher": "EphiCohen",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sbatch"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "contributes": {
    "configuration": {
      "title": "SBATCH",
      "properties": {
        "sbatch.commandTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 100,
          "description": "Maximum time (ms) a SLURM command may run before it is killed and reported as timed out."
        },
        "sbatch.refreshIntervalMs": {
          "type": "number",
          "default": 1000,
          "minimum": 250,
          "description": "How often the job list auto-refreshes (ms)."
        },
        "sbatch.sacctCacheMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "description": "How long sacct history results are cached before re-querying (ms)."
        },
        "sbatch.userFilter": {
          "type": "string",
          "enum": ["me", "all"],
          "default": "me",
          "description": "Which user's jobs are listed. 'all' shows every user's jobs (requires cluster permission)."
        },
        "sbatch.sinfoArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra arguments passed to sinfo (used by live completion)."
        },
        "sbatch.sbatchPath": {
          "type": "string",
          "default": "sbatch",
          "description": "Path to the sbatch binary."
        },
        "sbatch.squeuePath": {
          "type": "string",
          "default": "squeue",
          "description": "Path to the squeue binary."
        },
        "sbatch.sacctPath": {
          "type": "string",
          "default": "sacct",
          "description": "Path to the sacct binary."
        },
        "sbatch.scancelPath": {
          "type": "string",
          "default": "scancel",
          "description": "Path to the scancel binary."
        },
        "sbatch.sinfoPath": {
          "type": "string",
          "default": "sinfo",
          "description": "Path to the sinfo binary."
        }
      }
    },
    "languages": [
      {
        "id": "sbatch",
        "aliases": ["SBATCH", "sbatch"],
        "extensions": [".sbatch"],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./images/svg/sbatch.svg",
          "light": "./images/svg/sbatch.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sbatch",
        "scopeName": "source.sbatch",
        "path": "./syntaxes/sbatch.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sbatch.submitSlurmJob",
        "title": "Submit a SLURM Job from This File"
      },
      {
        "command": "sbatch.listSubmittedJobs",
        "title": "List Submitted Jobs from This File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "sbatch.submitSlurmJob",
          "when": "resourceExtname == .sbatch",
          "group": "navigation"
        },
        {
          "command": "sbatch.listSubmittedJobs",
          "when": "resourceExtname == .sbatch",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sbatch.submitSlurmJob",
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == sbatch && !suggestWidgetVisible"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "package": "vsce package",
    "vscode:prepublish": "npm run lint"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ephi052/VS-Code-SBATCH-Syntax-Highlighting.git"
  },
  "bugs": {
    "url": "https://github.com/ephi052/VS-Code-SBATCH-Syntax-Highlighting/issues"
  },
  "homepage": "https://github.com/ephi052/VS-Code-SBATCH-Syntax-Highlighting#readme",
  "keywords": [
    "SBATCH",
    "SLURM",
    "syntax highlighting",
    "HPC"
  ],
  "author": "Ephi Cohen",
  "license": "MIT"
}
