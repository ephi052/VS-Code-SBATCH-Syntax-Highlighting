{
  "scopeName": "source.sbatch",
  "patterns": [
    {
      "name": "comment.line.disabled.sbatch",
      "match": "^#{2,}SBATCH\\b.*$",
      "comment": "Disabled SBATCH directive: ##SBATCH, ###SBATCH, ... Comment-colored, but themeable separately."
    },
    {
      "begin": "^(#SBATCH)\\s*",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "keyword.control.sbatch" }
      },
      "contentName": "meta.arguments.sbatch",
      "patterns": [
        {
          "comment": "Dangling '--' with no option name is not accepted by SLURM",
          "name": "invalid.illegal.sbatch",
          "match": "--\\s*$|--(?=\\s)"
        },
        {
          "comment": "Whitespace around '=' (e.g. --job-name = x) is rejected by SLURM",
          "name": "invalid.illegal.sbatch",
          "match": "\\s+=\\s*|\\s*=\\s+"
        },
        {
          "comment": "GRES resources: gpu:a100:2, gpu:2, gpu:a100, gpu -> type : model : count",
          "begin": "(--gres)(\\s*=\\s*)?",
          "end": "(?=\\s|$)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.sbatch" },
            "2": { "name": "keyword.operator.assignment.sbatch" }
          },
          "contentName": "meta.gres.value.sbatch",
          "patterns": [
            {
              "comment": "type:model:count",
              "match": "([A-Za-z0-9_.-]+)(:)([A-Za-z0-9_.-]+)(:)(\\d+)",
              "captures": {
                "1": { "name": "entity.name.type.resource.sbatch" },
                "2": { "name": "punctuation.separator.sbatch" },
                "3": { "name": "entity.name.resource.sbatch" },
                "4": { "name": "punctuation.separator.sbatch" },
                "5": { "name": "constant.numeric.sbatch" }
              }
            },
            {
              "comment": "type:count",
              "match": "([A-Za-z0-9_.-]+)(:)(\\d+)",
              "captures": {
                "1": { "name": "entity.name.type.resource.sbatch" },
                "2": { "name": "punctuation.separator.sbatch" },
                "3": { "name": "constant.numeric.sbatch" }
              }
            },
            {
              "comment": "type:model",
              "match": "([A-Za-z0-9_.-]+)(:)([A-Za-z0-9_.-]+)",
              "captures": {
                "1": { "name": "entity.name.type.resource.sbatch" },
                "2": { "name": "punctuation.separator.sbatch" },
                "3": { "name": "entity.name.resource.sbatch" }
              }
            },
            { "match": "[A-Za-z0-9_.-]+", "name": "entity.name.type.resource.sbatch" },
            { "match": ",", "name": "punctuation.separator.sbatch" },
            { "match": ":", "name": "punctuation.separator.sbatch" },
            { "match": "\\d+", "name": "constant.numeric.sbatch" }
          ]
        },
        {
          "comment": "--mail-type / --mail-on-event: option-aware enums (so a partition named END stays plain)",
          "begin": "(--mail-on-event|--mail-type)(=|\\s+)?",
          "end": "(?=\\s|$)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.sbatch" },
            "2": { "name": "keyword.operator.assignment.sbatch" }
          },
          "patterns": [
            {
              "name": "constant.language.sbatch",
              "match": "\\b(?:ALL|BEGIN|END|FAIL|NONE|REQUEUE|TIME_LIMIT|INVALID_DEPEND|STAGE_OUT|ARRAY_TASKS)\\b"
            }
          ]
        },
        {
          "comment": "--time / -t: only SLURM time literals are interpreted here",
          "begin": "(--time|-t)(=|\\s+)?",
          "end": "(?=\\s|$)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.sbatch" },
            "2": { "name": "keyword.operator.assignment.sbatch" }
          },
          "patterns": [
            {
              "name": "constant.numeric.time.sbatch",
              "match": "\\b(?:\\d+-)?\\d{1,2}:\\d{2}(?::\\d{2})?\\b"
            },
            { "name": "constant.numeric.sbatch", "match": "\\d+" }
          ]
        },
        {
          "comment": "--mem / --mem-per-cpu / --mem-per-gpu: number + unit",
          "begin": "(--mem-per-gpu|--mem-per-cpu|--mem)(=|\\s+)?",
          "end": "(?=\\s|$)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.sbatch" },
            "2": { "name": "keyword.operator.assignment.sbatch" }
          },
          "patterns": [
            {
              "comment": "memory quantity: 32G, 5GB, 1500MB, 4.5GiB",
              "match": "(\\d+(?:\\.\\d+)?)\\s*([KMGTPE]i?B?)",
              "captures": {
                "1": { "name": "constant.numeric.sbatch" },
                "2": { "name": "constant.other.unit.sbatch" }
              }
            },
            { "name": "constant.numeric.sbatch", "match": "\\d+" },
            { "name": "constant.language.sbatch", "match": "\\bUNLIMITED\\b" }
          ]
        },
        {
          "comment": "--output / --error: filename grammar with % placeholders",
          "begin": "(--output|--error|-o|-e)(=|\\s+)?",
          "end": "(?=\\s|$)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.sbatch" },
            "2": { "name": "keyword.operator.assignment.sbatch" }
          },
          "patterns": [
            {
              "name": "string.quoted.double.sbatch",
              "begin": "\"",
              "end": "\"",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.string.begin.sbatch" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.string.end.sbatch" }
              },
              "patterns": [
                { "include": "#filename_variable" }
              ]
            },
            {
              "name": "string.quoted.single.sbatch",
              "begin": "'",
              "end": "'",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.string.begin.sbatch" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.string.end.sbatch" }
              }
            },
            {
              "comment": "path with placeholder split: logs/job-%j.out -> logs/job- [%j] .out",
              "match": "([\\w./@~-]*)(%(?:\\d+)?[A-Za-z%])([\\w./@~-]*)",
              "captures": {
                "1": { "name": "string.other.path.sbatch" },
                "2": { "name": "constant.character.format.placeholder.sbatch" },
                "3": { "name": "string.other.path.sbatch" }
              }
            },
            { "name": "string.other.path.sbatch", "match": "[\\w./@~-]*[/.@][\\w./@~-]*" },
            { "name": "string.other.path.sbatch", "match": "\\S+" }
          ]
        },
        {
          "comment": "Numeric count options: --nodes, --ntasks, --cpus-per-task, --gpus, ...",
          "begin": "(--ntasks-per-node|--cpus-per-task|--cpus-per-gpu|--gpus-per-node|--gpus-per-task|--ntasks|--nodes|--gpus|-N|-n|-c)(=|\\s+)?",
          "end": "(?=\\s|$)",
          "beginCaptures": {
            "1": { "name": "variable.parameter.sbatch" },
            "2": { "name": "keyword.operator.assignment.sbatch" }
          },
          "patterns": [
            { "name": "constant.numeric.sbatch", "match": "\\d+\\s*-\\s*\\d+" },
            { "name": "constant.numeric.sbatch", "match": "\\d+" }
          ]
        },
        {
          "name": "variable.parameter.sbatch",
          "match": "--?[a-zA-Z][a-zA-Z0-9-_]*"
        },
        {
          "name": "keyword.operator.assignment.sbatch",
          "match": "="
        },
        {
          "name": "constant.numeric.sbatch",
          "match": "\\b\\d+(?:\\.\\d*)?\\b"
        },
        {
          "name": "string.quoted.double.sbatch",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.sbatch" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.sbatch" }
          },
          "patterns": [
            { "include": "#filename_variable" }
          ]
        },
        {
          "name": "string.quoted.single.sbatch",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.sbatch" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.sbatch" }
          }
        },
        {
          "comment": "SLURM-provided environment variables: $SLURM_JOBID, ${SLURM_JOB_NODELIST}",
          "name": "variable.language.slurm.sbatch",
          "match": "\\$\\{?SLURM_[A-Za-z0-9_]+\\}?"
        },
        {
          "name": "variable.other.sbatch",
          "match": "\\$\\{[^}]*\\}|\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "comment.line.sbatch",
          "match": "#.*$"
        }
      ]
    },
    {
      "include": "source.shell"
    }
  ],
  "repository": {
    "filename_variable": {
      "name": "constant.character.format.placeholder.other.sbatch",
      "match": "%(?:\\d+)?[A-Za-z%]"
    }
  }
}
